# =============================================================================
# Media Jungle - Environment Configuration Template (.env.example)
# SOC 2 Control 13: Secret Management
# Copy this file to .env and configure actual production/staging values.
# NEVER commit .env to version control.
# =============================================================================

# Database Configuration (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediaJungle
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_abcdef1234567890

# SMTP Mail Settings
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_app_password
ERROR_RECEIVING_MAIL=support@example.com
ERROR_SENDER_MAIL=alerts@example.com

# Media Storage Directories
PROJECT_VIDEO=uploads/videos
PROJECT_VR_VIDEO=uploads/vr_videos
PROJECT_TEST_VIDEO=uploads/test_videos
PROJECT_TEST_OUTPUT=uploads/test_output
PROJECT_VIDEO_TRAILER=uploads/trailers
PROJECT_AD_VIDEOS=uploads/ad_videos
FILE_UPLOAD_DIR=uploads
UPLOAD_LICENCE_DIR=uploads/licences
UPLOAD_AUDIO_DIR=uploads/audio
UPLOAD_PROFILE_DIR=uploads/profiles
APP_STORAGE_PRIVATE=storage/private
APP_STORAGE_PUBLIC=storage/public
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
PROJECT_URL=http://localhost:8080

# Payment Gateway (Razorpay)
RZP_CURRENCY=INR
RZP_COMPANY_NAME=Media Jungle

# OAuth2 Google (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
